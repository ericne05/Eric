# Eric Environment Configuration
# Copy this file to .env and fill in your values.
# .env is ignored by Git — never commit secrets.

# ── LLM API Keys ──────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── External Services ─────────────────────────────
DISCORD_BOT_TOKEN=
GITHUB_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Application ───────────────────────────────────
ERIC_ENV=development
ERIC_LOG_LEVEL=DEBUG
